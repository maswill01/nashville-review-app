# Copy to .env for local development. On Railway these are set as service variables.

# Postgres connection string.
# On Railway: reference the Postgres service with ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nashville

# Password to get into the app. If unset, the app is wide open — always set it in production.
APP_PASSWORD=change-me

# Signs the login cookie. Any long random string. If unset, you get logged out on every restart.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to true only if your DATABASE_URL needs TLS (Railway's public proxy URL does; the private one does not).
# PGSSL=true
