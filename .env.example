# Copy to .env for local development. On Railway these are set as service variables.

# Postgres connection string.
# On Railway: reference the Postgres service with ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nashville

# The code someone needs to create an account. Text it to the people you want on the
# list; it is asked for at signup only, never again at login. If unset, anyone who
# finds the URL can make an account and read every list — always set it in production.
# Still read from APP_PASSWORD when INVITE_CODE is missing, so the old Railway
# variable keeps working across the deploy that ships accounts.
INVITE_CODE=change-me

# Signs every login cookie. Any long random string. If unset, everyone is logged out
# on every restart. Changing it logs every device out, which is the blunt way to
# revoke access; to cut off one account, bump its users.token_version instead.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The account that inherits every place saved before accounts existed. On the first
# boot after this deploy the app creates it (if OWNER_PASSWORD is at least 8
# characters) and hands it every row with no owner. An account that already exists is
# never touched, so leaving these set is harmless and clearing them afterwards is fine.
OWNER_USERNAME=
OWNER_PASSWORD=

# Set to true only if your DATABASE_URL needs TLS (Railway's public proxy URL does; the private one does not).
# PGSSL=true

# ---------------------------------------------------------------------------
# Place search. Set ONE of these to turn the Name field into a place picker that
# fills in the address, coordinates, neighborhood and price with one tap.
# With neither set the app still works — you just type the name.
# The key stays on the server; the browser only ever talks to /api/place-search.
# ---------------------------------------------------------------------------

# Google Places API (New). Best coverage and price data, but the key needs a
# billing account. Enable "Places API (New)" in Google Cloud, then restrict the
# key to that API. Takes priority if both keys are set.
# GOOGLE_PLACES_API_KEY=

# Foursquare Places API. Free tier, no billing setup. Create a project at
# foursquare.com/developers and use its Service Key.
# FOURSQUARE_API_KEY=

# Pin the Foursquare API version if their default ever moves under you.
# FOURSQUARE_API_VERSION=2025-06-17
